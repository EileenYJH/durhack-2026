# Copy to .env and fill in. .env is git-ignored. Both are optional:
# without them the brief is rule-based and the voice is the browser's own.

# Google AI Studio key, for the commander's brief
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# ElevenLabs key, for the spoken brief
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_MODEL=eleven_flash_v2_5

# PORT=8200
