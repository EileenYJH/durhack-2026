# Copy to .env and fill in. .env is git-ignored. Everything here is optional:
# without Gemini the brief is rule-based, without ElevenLabs the browser reads it.

# ---- Gemini: pick ONE route ----------------------------------------------------

# Route 1: Google AI Studio (an API key from aistudio.google.com)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash

# Route 2: Vertex AI express mode, one key and nothing else to install.
#   Put a Vertex AI key in VERTEX_API_KEY (or reuse GEMINI_API_KEY), then:
# GEMINI_PROVIDER=vertex-express
# VERTEX_API_KEY=
#   The key's Google Cloud project must have the Vertex AI API enabled and billing or credits.
#
# Route 3: full Vertex AI for a project. Uncomment these three and leave GEMINI_API_KEY empty.
# GEMINI_PROVIDER=vertex
# GCP_PROJECT=your-project-id
# GCP_LOCATION=global
#
# Sign-in for Vertex, one of:
#   on your own machine:  gcloud auth application-default login
#   on a server:          GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
# Newer Gemini models are often served only from GCP_LOCATION=global.
# Check it works:  node scripts/check-gemini.js

# ---- ElevenLabs (spoken brief) -------------------------------------------------
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_MODEL=eleven_flash_v2_5

# PORT=8200
